# Пример настроек. Скопируйте в .env (он в .gitignore) или задайте переменные в панели хостинга.
# Здесь только ЗАГЛУШКИ: настоящие значения в репозиторий не попадают никогда.

# Порт и адрес. На хостинге HOST=0.0.0.0, PORT чаще всего даёт сам хостинг.
PORT=4173
HOST=127.0.0.1

# Путь к файлу базы SQLite. На хостинге — на постоянном диске (например /var/data/jenius.db).
DB_PATH=./data/jenius.db

# Разрешённые Host/Origin через запятую (ваш домен). В разработке с Vite: localhost:5173,127.0.0.1:5173
ALLOWED_HOSTS=

# Только за HTTPS: cookie получает флаг Secure.
COOKIE_SECURE=0
# 1 — если перед сервером стоит прокси хостинга (берём реальный IP из X-Forwarded-For).
TRUST_PROXY=0

# Сообщения «Bizga yozing» уходят в Telegram. Оставьте пустыми, если не нужно: тогда сервер ответит 503.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
