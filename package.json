{
  "name": "jenius",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:server": "JENIUS_DEV=1 ALLOWED_HOSTS=localhost:5173,127.0.0.1:5173 node --watch server.mjs",
    "dev:client": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production node server.mjs",
    "preview": "npm run build && npm start",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "vitest run",
    "check": "npm test && npm run test:ui && npm run build",
    "e2e": "node tests/browser-e2e.mjs",
    "e2e:blank": "node tests/browser-blank-boot.mjs",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:import-sqlite": "node scripts/import-sqlite.mjs"
  },
  "files": [
    "server.mjs",
    "server",
    "shared",
    "client",
    "api",
    "migrations",
    "scripts",
    "dist",
    "vercel.json",
    "vite.config.js",
    ".env.example",
    "README.md",
    "VERCEL-SETUP.md",
    "CHANGELOG-react.md"
  ],
  "engines": {
    "node": "26.x"
  },
  "dependencies": {
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
